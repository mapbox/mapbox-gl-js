{
  "compilerOptions": {
    "target": "es2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "isolatedModules": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "mapbox-gl": ["../../dist/mapbox-gl.d.ts"],
      "mapbox-gl/esm": ["../../dist/esm/mapbox-gl.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
