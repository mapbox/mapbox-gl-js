{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "./rollup/build/types"
  },
  "include": [
    "./src/**/*",
    "./3d-style/**/*",
    "./plugins/**/*",
    "./modules/**/*",
    "./internal/**/*",
    "./package.json",
    "./src/style-spec/reference/**/*.json"
  ],
  "exclude": [
    "./src/style-spec/bin",
    "./src/style-spec/dist",
    "./src/style-spec/test.js",
    "./src/style-spec/rollup.config.js",
    "./internal/scripts/**/*",
    "./plugins/**/rollup.config.ts",
    "./plugins/*/dist"
  ]
}
