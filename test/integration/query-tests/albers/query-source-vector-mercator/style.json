{
  "version": 8,
  "_comment": "Mercator twin of query-source-vector-albers; same source layer, same filter, and deliberately the same expected.json.",
  "metadata": {
    "test": {
      "width": 512,
      "height": 512,
      "querySource": "mapbox",
      "queryOptions": {
        "sourceLayers": [
          "country_boundaries"
        ],
        "filter": [
          "==",
          [
            "get",
            "iso_3166_1"
          ],
          "IS"
        ]
      },
      "skip-test": [
        {
          "platform-tag-contains": "web",
          "reason": "querySourceFeatures is driven by metadata.test.querySource, which only the native render-test runner implements; the gl-js query harness reads queryGeometry only."
        }
      ]
    }
  },
  "center": [
    -19,
    65
  ],
  "zoom": 3,
  "sources": {
    "mapbox": {
      "type": "vector",
      "maxzoom": 0,
      "tiles": [
        "local://tiles/mapbox.mapbox-streets-v8/{z}-{x}-{y}.mvt"
      ]
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "white"
      }
    },
    {
      "id": "country-boundaries",
      "type": "fill",
      "source": "mapbox",
      "source-layer": "country_boundaries",
      "paint": {
        "fill-color": "#3060c0"
      }
    }
  ]
}