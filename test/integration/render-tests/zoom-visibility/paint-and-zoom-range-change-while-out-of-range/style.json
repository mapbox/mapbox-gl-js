{
  "description": "A layer with a zoom-dependent radius is outside its zoom range. Its color changes, then the zoom changes from 3 to 3.5, both while it stays out of range. Its zoom range is then extended to include the current zoom, without another zoom change. It must render blue at the radius for zoom 3.5, the same size as the red reference circle of radius 7.",
  "version": 8,
  "metadata": {
    "test": {
      "width": 64,
      "height": 32,
      "operations": [
        [
          "wait"
        ],
        [
          "setPaintProperty",
          "circle",
          "circle-color",
          "blue"
        ],
        [
          "wait"
        ],
        [
          "setZoom",
          3.5
        ],
        [
          "wait"
        ],
        [
          "setLayerZoomRange",
          "circle",
          0,
          24
        ],
        [
          "wait"
        ]
      ]
    }
  },
  "zoom": 3,
  "transition": {
    "duration": 0
  },
  "sources": {
    "geojson": {
      "type": "geojson",
      "data": {
        "type": "Point",
        "coordinates": [
          0,
          0
        ]
      }
    }
  },
  "layers": [
    {
      "id": "circle",
      "type": "circle",
      "source": "geojson",
      "minzoom": 4,
      "paint": {
        "circle-radius": [
          "interpolate",
          ["linear"],
          ["zoom"],
          2, 4,
          6, 12
        ],
        "circle-color": "red"
      }
    },
    {
      "id": "reference",
      "type": "circle",
      "source": "geojson",
      "paint": {
        "circle-radius": 7,
        "circle-color": "red",
        "circle-translate": [22, 0]
      }
    }
  ]
}
