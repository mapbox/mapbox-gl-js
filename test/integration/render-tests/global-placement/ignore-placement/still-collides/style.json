{
  "description": "icon-ignore-placement is not icon-allow-overlap: a lower-priority icon with icon-ignore-placement is still hidden when it overlaps a placed symbol.",
  "version": 8,
  "metadata": {
    "test": {
      "width": 64,
      "height": 64,
      "collisionDebug": true,
      "globalPlacement": true,
      "skip-test": [
        {
          "platform-tag-contains": "native",
          "reason": "not-implemented: in gl-native"
        }
      ]
    }
  },
  "center": [
    0,
    0
  ],
  "zoom": 0,
  "sources": {
    "a": {
      "type": "geojson",
      "data": {
        "type": "Point",
        "coordinates": [
          0,
          0
        ]
      }
    }
  },
  "sprite": "local://sprites/standard",
  "glyphs": "local://glyphs/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "lower",
      "type": "symbol",
      "source": "a",
      "layout": {
        "icon-image": "cafe",
        "icon-size": 0.5,
        "icon-offset": [
          10,
          10
        ],
        "icon-ignore-placement": true
      }
    },
    {
      "id": "top",
      "type": "symbol",
      "source": "a",
      "layout": {
        "icon-size": 0.5,
        "icon-image": "information"
      }
    }
  ]
}
