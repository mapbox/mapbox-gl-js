{
  "description": "Tests that fill-pattern cross-fading completes, by checking the rendering after the fade duration has elapsed.",
  "version": 8,
  "metadata": {
    "test": {
      
      "pixelRatio": 2,
      "width": 64,
      "height": 64,
      "operations": [
        [
          "wait"
        ],
        [
          "setZoom",
          1.1
        ],
        [
          "wait",
          0
        ],
        [
          "wait",
          1000
        ]
      ],
      "image-threshold": [
        {"platform-tag-contains": "", "threshold": 0.00056},
        {"platform-tag-contains": "native-macos", "threshold": 0.0012},
        {"platform-tag-contains": "native-ios", "threshold": 0.0012},
        {"platform-tag-contains": "native-android-gl-adreno", "threshold": 0.00092},
        {"platform-tag-contains": "native-android-gl-mali", "threshold": 0.00092}
      ]
    }
  },
  "sources": {
    "geojson": {
      "type": "geojson",
      "data": {
        "type": "Polygon",
        "coordinates": [
          [
            [
              -10,
              -10
            ],
            [
              -10,
              10
            ],
            [
              10,
              10
            ],
            [
              10,
              -10
            ],
            [
              -10,
              -10
            ]
          ]
        ]
      }
    }
  },
  "sprite": "local://sprites/standard",
  "layers": [
    {
      "id": "fill",
      "type": "fill",
      "source": "geojson",
      "paint": {
        "fill-antialias": false,
        "fill-pattern": "globe_blue"
      }
    }
  ]
}
