{
  "description": "Equal circle-sort-key keeps source order: red, green, blue drawn bottom to top.",
  "version": 8,
  "metadata": {
    "test": {
      "width": 64,
      "height": 64
    }
  },
  "center": [
    0,
    0
  ],
  "zoom": 0,
  "sources": {
    "geojson": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": [
          {
            "type": "Feature",
            "properties": {
              "v": 1
            },
            "geometry": {
              "type": "Point",
              "coordinates": [
                -8,
                8
              ]
            }
          },
          {
            "type": "Feature",
            "properties": {
              "v": 2
            },
            "geometry": {
              "type": "Point",
              "coordinates": [
                0,
                0
              ]
            }
          },
          {
            "type": "Feature",
            "properties": {
              "v": 3
            },
            "geometry": {
              "type": "Point",
              "coordinates": [
                8,
                -8
              ]
            }
          }
        ]
      }
    }
  },
  "layers": [
    {
      "id": "layer",
      "source": "geojson",
      "type": "circle",
      "layout": {
        "circle-sort-key": 1
      },
      "paint": {
        "circle-radius": 14,
        "circle-color": [
          "match",
          [
            "get",
            "v"
          ],
          1,
          "red",
          2,
          "green",
          3,
          "blue",
          "black"
        ]
      }
    }
  ]
}
