{
  "version": 8,
  "metadata": {
    "test": {
      "width": 512,
      "height": 512,
      "description": "Separates polar Albers background, fill, outline, and point rendering.",
      "operations": [
        ["setProjection", {
          "name": "albers",
          "center": [-38, 0],
          "parallels": [90, 90]
