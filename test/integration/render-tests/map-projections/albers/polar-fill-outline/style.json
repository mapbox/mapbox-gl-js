      "data": {
        "type": "FeatureCollection",
        "features": [
          {
            "type": "Feature",
            "properties": {},
            "geometry": {
              "type": "Polygon",
              "coordinates": [[
                [-180, 70],
                [-120, 70],
                [-60, 70],
                [0, 70],
                [60, 70],
                [120, 70],
                [180, 70],
                [180, 89],
                [-180, 89],
                [-180, 70]
              ]]
            }
          }
        ]
      }
    },
    "pole": {
      "type": "geojson",
      "data": {
        "type": "Point",
        "coordinates": [-38, 89]
      }
    }
  },
  "layers": [
    {
