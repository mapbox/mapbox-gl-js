{
  "version": 8,
  "metadata": {
    "test": {
      "width": 512,
      "height": 512,
      "description": "Isolates vector-tile country boundaries under a polar Albers configuration.",
      "operations": [
        ["setProjection", {
          "name": "albers",
          "center": [-38, 0],
          "parallels": [90, 90]
        }],
        ["wait"]
      ],
      "skip-test": [
        {"platform-tag-contains": "native", "reason": "skip - https://github.com/mapbox/mapbox-gl-native-internal/issues/2534"}
      ]
    }
  },
  "center": [12.5683, 55.6761],
  "sources": {
    "mapbox": {
      "type": "vector",
      "url": "mapbox://mapbox.mapbox-streets-v7"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#ffffff"
      }
    },
    {
      "id": "admin-country",
      "type": "line",
      "source": "mapbox",
      "source-layer": "admin",
      "filter": [
        "all",
        ["==", "$type", "LineString"],
        ["<=", "admin_level", 2],
        ["==", "maritime", 0]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#000000",
        "line-width": 2
      }
    }
  ]
}
