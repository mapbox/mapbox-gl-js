{
  "description": "Feature-state changes on a draped line layer invalidate the terrain render cache.",
  "version": 8,
  "metadata": {
    "test": {
      "tickets": ["https://mapbox.atlassian.net/browse/MAPSNAT-4268"],
      "height": 64,
      "width": 64,
      "operations": [
        ["forceRenderCached", true],
        ["wait"],
        ["setFeatureState", {"source": "geojson", "id": 1}, {"hover": true}],
        ["wait"]
      ],
      "skip-test": [
        {"platform-tag-contains": "native", "reason": "bug: draped tiles are not invalidated on feature state change - MAPSNAT-4268"}
      ]
    }
  },
  "center": [-113.26903, 35.9654],
  "zoom": 11,
  "pitch": 45,
  "terrain": {
    "source": "rgbterrain"
  },
  "sources": {
    "rgbterrain": {
      "type": "raster-dem",
      "tiles": [
        "local://tiles/{z}-{x}-{y}.terrain.png"
      ],
      "maxzoom": 15,
      "tileSize": 256
    },
    "geojson": {
      "type": "geojson",
      "data": {
        "type": "Feature",
        "id": 1,
        "geometry": {
          "type": "LineString",
          "coordinates": [[-113.29, 35.9654], [-113.25, 35.9654]]
        }
      }
    }
  },
  "layers": [
    {
      "id": "line",
      "type": "line",
      "source": "geojson",
      "paint": {
        "line-width": 8,
        "line-color": ["case", ["boolean", ["feature-state", "hover"], false], "red", "blue"]
      }
    }
  ]
}
