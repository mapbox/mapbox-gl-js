{
  "version": 8,
  "metadata": {
    "test": {
      "width": 256,
      "height": 256,
      "operations": [
        ["setProjection", "albers"],
        ["wait"]
      ],
      "image-threshold": [
        {"platform-tag-contains": "native", "threshold": 0.00025}
      ]
    }
  },
  "zoom": 3,
  "sources": {
    "geojson": {
      "type": "geojson",
      "data": {
        "type": "Point",
        "coordinates": [
          0,
          0
        ]
      }
    },
    "graticule": {
      "type": "geojson",
      "data": "local://data/graticule.geojson"
    }
  },
  "glyphs": "local://glyphs/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "symbol",
      "type": "symbol",
      "source": "geojson",
      "layout": {
        "text-field": "ABC",
        "text-font": [
          "Open Sans Semibold",
          "Arial Unicode MS Bold"
        ],
        "text-size": 96
      }
    },
    {
      "id": "graticule",
      "source": "graticule",
      "type": "line",
      "paint": {
          "line-width": 1,
          "line-color": "#aaa"
      }
    }
  ]
}
