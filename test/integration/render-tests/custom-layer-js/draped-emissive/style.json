{
  "version": 8,
  "metadata": {
    "test": {
      "width": 600,
      "height": 400,
      "emissiveColorPrecision": "exact",
       "skip-test": [
        {"platform-tag-contains": "native", "reason": "skip - js specific"}
      ],
      "image-threshold": [
        {
          "platform-tag-contains": "",
          "threshold": 0.0003
        }
      ],
       "operations": [
        ["wait"],
        ["addCustomLayer", "triangle-draped-emissive"],
        ["wait"]
       ]
    }
  },
  "zoom": 2.5,
  "pitch": 0.0,
  "center": [
    45,
    40
  ],
  "projection": {
    "name": "globe"
  },
  "fog": {
    "star-intensity": 0
  },
  "lights": [
    {
      "type": "ambient",
      "id": "test_ambient",
      "properties": {
        "color": "rgba(10, 30, 170, 1)",
        "intensity": 1.0
      }
    },
    {
      "type": "directional",
      "id": "test_directional",
      "properties": {
        "color": "rgba(0, 0, 0, 1)"
      }
    }
  ],
  "sources": {
    "mapbox": {
      "type": "vector",
      "maxzoom": 14,
      "tiles": [
        "local://tiles/{z}-{x}-{y}.mvt"
      ]
    },
    "image-1": {
      "type": "raster",
      "tiles": [
        "local://tiles/cross.png"
      ],
      "maxzoom": 17,
      "tileSize": 256
    }
  },
  "transition": {
    "duration": 0
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "black"
      }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "mapbox",
      "source-layer": "water",
      "paint": {
        "fill-color": "lightblue"
      }
    },
    {
      "id": "image-1",
      "type": "raster",
      "source": "image-1",
      "paint": {
        "raster-fade-duration": 0,
        "raster-opacity": 0.5,
        "raster-emissive-strength": 0.5
      }
    
    }
  ]
}